#!/bin/bash
# decksay - speak text with Piper (neural TTS). Picks ru/en from the text itself.
#   decksay "text"      | echo text | decksay
#   decksay --stop      stop whatever is being spoken
BASE=$HOME/.local/share/decktts
PY=$BASE/venv/bin/python
VOICES=$BASE/voices
PIDFILE=$BASE/speaking.pid
CONF=$BASE/config

# Settings live in one small file so the console's menu can change them
# without editing this script: RU_VOICE, EN_VOICE, SPEED.
[ -f "$CONF" ] && . "$CONF"
RU_VOICE=${RU_VOICE:-ru_RU-dmitri-medium}
EN_VOICE=${EN_VOICE:-en_US-amy-medium}
SPEED=${SPEED:-1.0}

stop_current() {
  [ -f "$PIDFILE" ] || return 0
  while read -r p; do kill "$p" 2>/dev/null; done < "$PIDFILE"
  rm -f "$PIDFILE"
}

[ "$1" = "--stop" ] && { stop_current; exit 0; }

text=${1:-$(cat)}
# strip markdown / code / urls so it reads like speech, not like a file
text=$(printf '%s' "$text" | python3 -c '
import re,sys
t=sys.stdin.read()
t=re.sub(r"```.*?```"," (код) ",t,flags=re.S)
t=re.sub(r"`[^`]*`"," ",t)
t=re.sub(r"https?://\S+"," ссылка ",t)
t=re.sub(r"[*_#>|\[\]()~]"," ",t)
t=re.sub(r"\s+"," ",t).strip()
sys.stdout.write(t[:1500])')
[ -z "$text" ] && exit 0

case "$text" in
  *[А-Яа-яЁё]*) MODEL=$VOICES/$RU_VOICE.onnx ;;
  *)            MODEL=$VOICES/$EN_VOICE.onnx ;;
esac
# Fall back to whatever is actually installed rather than saying nothing.
[ -f "$MODEL" ] || MODEL=$(ls "$VOICES"/*.onnx 2>/dev/null | head -1)
[ -f "$MODEL" ] || exit 0

stop_current
mkdir -p "$BASE"
printf '%s' "$text" \
  | "$PY" -m piper -m "$MODEL" --length-scale "$(awk -v s="$SPEED" 'BEGIN{printf "%.2f", 1/s}')" --output-raw 2>/dev/null \
  | "$HOME/.local/bin/deckpad" \
  | pw-play --raw --rate 22050 --format s16 --channels 1 - >/dev/null 2>&1 &
# record the whole pipeline so --stop can kill it
jobs -p > "$PIDFILE"
pgrep -P $$ >> "$PIDFILE" 2>/dev/null
wait
rm -f "$PIDFILE"
